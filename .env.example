# String de ligação ao PostgreSQL:
# postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Fornecedores geridos (Supabase, Neon, Railway, Vercel Postgres) dão a
# connection string já com ?sslmode=require.
DATABASE_URL=postgres://user:password@host:5432/bettrackr

# Segredo usado para assinar os JWT. Gera um valor aleatório forte:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Chave da API do Gemini, usada na importação de boletins por screenshot
# e nas AI Insights diárias.
GEMINI_API_KEY=

# Segredo do cron das AI Insights. A Vercel envia-o em
# "Authorization: Bearer <valor>" ao chamar /api/insights/cron (ver crons no
# vercel.json). Sem isto definido, o endpoint recusa TODOS os pedidos, para
# ninguém poder disparar gerações à custa da tua quota. Gera um valor forte:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ------------------------------------------------------------
# Subscrição BetTrackr Pro (3,99 €/mês) - Stripe
# ------------------------------------------------------------
# Sem STRIPE_SECRET_KEY a app funciona à mesma: o botão de pagar não aparece
# e o acesso passa a depender do período experimental ou de uma subscrição
# concedida à mão no painel de gestão.
STRIPE_SECRET_KEY=

# Segredo do webhook (Stripe > Developers > Webhooks). Sem ele o endpoint
# /api/billing/webhook recusa tudo - é o que impede alguém de se dar
# subscrições grátis inventando eventos.
# Eventos a subscrever: checkout.session.completed,
# customer.subscription.created/updated/deleted
STRIPE_WEBHOOK_SECRET=

# Opcional: id de um preço recorrente já criado no Stripe. Sem ele, o preço
# (3,99 EUR/mês) vai inline no Checkout e não é preciso configurar nada no
# dashboard do Stripe.
STRIPE_PRICE_ID=

# Opcional: categoria fiscal do produto criado inline. Por omissão
# txcd_10103000 (Software as a service, uso pessoal), que é o que o BetTrackr
# é. As contas novas do Stripe têm "Managed Payments" ligado e recusam o
# Checkout sem categoria ("the product tax code is missing"). A lista completa
# vem da API: stripe.taxCodes.list().
STRIPE_TAX_CODE=

# Base dos redirecionamentos depois do pagamento. Se faltar, é deduzida do
# próprio pedido - define-a se a app estiver atrás de um proxy/domínio
# próprio. Ex.: https://betrackr.vercel.app
APP_URL=
