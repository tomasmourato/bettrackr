{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node", "bun"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true
  },
  // `allowJs` para os testes poderem importar a copia da extensao, que e JS
  // sem tipos. Sem `checkJs`, esses ficheiros sao lidos mas nao verificados.
  "include": [
    "src",
    "routes",
    "middleware",
    "db",
    "lib",
    "agent",
    "scripts",
    "test",
    "server.ts",
    "bootstrap.ts",
    "vite.config.ts"
  ]
}
